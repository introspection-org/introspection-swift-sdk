MARKER\\\"}}]}>>\",\"active_run_id\":\"01a1a9df-5613-758c-9b65-abf4c71a4928\",\"latest_run_id\":\"01a1a9df-5613-758c-9b65-abf4c71a4928\",\"crash_restarts\":null,\"history_recall\":null,\"conversation_id\":\"01a1a9df-5613-758c-9b65-abf53534ba83\",\"last_activity_at\":null,\"spawn_resolution\":{\"contract\":{\"kind\":\"pinned_git\",\"agent_name\":\"scripted\",\"recipe_sha\":\"f12cffb97ee8e0416f18570ff57f02e13beb6dbf\",\"recipe_repo\":\"9b9622c1-0550-54b9-bd97-2bece6afccc2\"},\"runtime_id\":\"01a1a9de-9a56-701a-94b6-d1941ef8340e\",\"attribution_env\":{\"OTEL_SERVICE_NAME\":\"hello-mcp\",\"INTROSPECTION_RECIPE_ID\":\"01a1a9de-93d5-7581-bbcf-f84faf615e7a\",\"INTROSPECTION_RECIPE_REF\":\"main\",\"INTROSPECTION_RUNTIME_ID\":\"01a1a9de-9a56-701a-94b6-d1941ef8340e\",\"INTROSPECTION_ENVIRONMENT\":\"production\",\"INTROSPECTION_RECIPE_KIND\":\"production\",\"INTROSPECTION_RUNTIME_KIND\":\"byor\",\"INTROSPECTION_RUNTIME_NAME\":\"hello-mcp\",\"INTROSPECTION_RUNTIME_GROUP_ID\":\"01a1a9de-85ab-70a1-a449-667e39925d99\",\"INTROSPECTION_JUDGES_OPERATIONAL\":\"{\\\"greeting\\\":{\\\"enabled\\\":true,\\\"sample_rate\\\":1.0,\\\"judge_id\\\":\\\"01a1a9de-8af6-77d1-98d3-803ddf0804ed\\\",\\\"definition_hash\\\":\\\"459455f76567d23931987f6e51b8709f8aca44f9c8f665a4d861297113406ba9\\\"}}\"},\"image_reference\":null,\"recipe_sub_path\":\"\",\"recipe_resources\":null,\"runtime_group_id\":\"01a1a9de-85ab-70a1-a449-667e39925d99\"},\"completion_reason\":null,\"runtime_environment\":\"production\",\"idle_timeout_seconds\":180},\"conversation_metadata\":{\"suite\":\"walk\",\"persona\":\"avery\"},\"tags\":[\"group:platform\",\"suite:walk\"],\"agent\":{\"sandbox_status\":\"provisioning\",\"session_id\":null}},\"run\":{\"id\":\"01a1a9df-5613-758c-9b65-abf4c71a4928\",\"task_id\":\"01a1a9df-5613-758c-9b65-abf53534ba83\",\"status\":\"pending\",\"created_at\":\"2026-11-05T04:02:28.502128Z\",\"updated_at\":\"2026-11-05T04:02:28.502128Z\",\"error\":null,\"completion_reason\":null}}"
