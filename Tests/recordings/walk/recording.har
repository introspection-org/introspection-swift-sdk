          "url" : "https://example-server.modelcontextprotocol.io/mock-upstream-idp/authorize?redirect_uri=/mock-upstream-idp/callback&state=77bfea5b88a5281e6f932e3cd0f1cc31fe9cdb4ed4c3f272c38e00116d056e91"
