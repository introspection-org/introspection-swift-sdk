            "size" : 835,
            "text" : "{\"records\":[{\"created_at\":\"2026-10-28T09:39:12.569271Z\",\"updated_at\":\"2026-10-28T09:39:12.607832Z\",\"org_id\":\"01a181dc-9258-765d-a097-503b84980b9c\",\"id\":\"01a181e0-c042-74a3-afc7-7029e484c48d\",\"name\":\"hello-mcp\",\"description\":\"Pi coding agent for hello-mcp.\",\"git_ref\":\"main\",\"git_commit_sha\":\"8c47669663ed605d81681032b41ca9d446e5ddae\",\"git_commit_subject\":null,\"sub_path\":\".\",\"project_id\":\"01a181e0-bc4b-75b7-8b40-4c37823d3185\",\"repository_id\":\"158a4283-5596-5abb-9a70-ee8d887fe1b6\",\"slug\":\"hello-mcp-8c47669\",\"created_by_member_id\":\"01a181dc-9270-74f6-937b-f181d44bc174\",\"mcp_servers\":[],\"policies\":null,\"validation\":{\"status\":\"valid\",\"validator_name\":\"introspection-recipe-check\",\"validator_version\":\"0.12.0\",\"checked_at\":\"2026-10-28T09:39:12.605697Z\",\"error_message\":null,\"diagnostics\":[]}}],\"count\":1,\"total_count\":null,\"next\":null}"
