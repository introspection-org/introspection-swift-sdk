            "mimeType" : "application/json",
            "size" : 2046,
            "text" : "{\"endpoint\":\"/v1/remotes/connect\",\"protocol\":\"wss (production) / ws (development, --insecure only)\",\"authentication\":{\"method\":\"CLI login access token carrying the remotes:connect scope\",\"description\":\"Used by introspection dev. Project API keys are runtime-only and cannot register a remote.\",\"example\":\"Authorization: Bearer <access_token>  (or ?token=<...>)\"},\"handshake\":[\"Client opens the socket and sends an attach_request frame first.\",\"Server replies attach_ok {attach_id} on success, or error and closes.\"],\"schema_version\":1,\"encoding\":\"Every WebSocket message is Message::Binary carrying one protobuf-encoded Frame. Schema: introspection-cli crates/protocol/proto/remote.proto. v1/v2 used JSON text frames + a custom binary chunk envelope; v3 collapses both.\",\"message_protocol\":{\"remote_to_cloud\":[{\"frame\":\"attach_request\",\"description\":\"First frame. Declares capabilities (role optional).\"},{\"frame\":\"heartbeat\",\"description\":\"Periodic (~20s) liveness + advisory worker status.\"},{\"frame\":\"primitive_result\",\"description\":\"Terminal result (status, error) for an mcp_request primitive.\"},{\"frame\":\"mcp_response_head\",\"description\":\"Upstream HTTP status + filtered headers for an mcp_request primitive.\"},{\"frame\":\"mcp_response_chunk\",\"description\":\"Upstream response body bytes for an mcp_request primitive.\"},{\"frame\":\"recipe\",\"description\":\"Reply to a recipe_request: the developer's current local Recipe overlay.\"},{\"frame\":\"recipe_invalidated\",\"description\":\"Push: the developer's local Recipe files changed; sandboxes re-pull.\"}],\"cloud_to_remote\":[{\"frame\":\"attach_ok\",\"description\":\"Handshake accepted; carries the attach_id.\"},{\"frame\":\"error\",\"description\":\"Protocol/auth error; the socket is then closed.\"},{\"frame\":\"primitive_dispatch\",\"description\":\"Run an mcp_request primitive against the developer's local MCP server.\"},{\"frame\":\"primitive_cancel\",\"description\":\"Cancel an in-flight mcp_request primitive.\"},{\"frame\":\"recipe_request\",\"description\":\"Ask the dev remote for its current local Recipe overlay content.\"}]}}"
          },
