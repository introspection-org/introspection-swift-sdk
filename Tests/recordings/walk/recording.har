the declared hello MCP whenever the task asks you to echo a message.\\n## Managed workspace\\n\\n<workspace>\\n  <inputs path=\\\"/workspace/files\\\" access=\\\"read_write\\\" persistence=\\\"task\\\" />\\n  <outputs path=\\\"/workspace/outputs\\\" persistence=\\\"task\\\" />\\n  Save downloaded source material under files/ and deliverables under outputs/. Mounted uploads and recipe files remain read-only; use a new path for modified copies.\\n</workspace>\\nUploaded inputs are read-only. Put intentional task deliverables in the outputs path so the platform can persist them.\\n\\n\\n## Session\\n\\n<session visibility=\\\"project\\\">\\n  <permissions plane=\\\"data\\\">annotations:read conversations:read events:read files:read files:write metrics:read shares:read shares:write tasks:read tasks:write repositories:write telemetry:write git:read</permissions>\\n</session>\\n\\n<cwd>\\n/workspace\\n</cwd>\"}]},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"contains\":{\"values\":[\"gen_ai.input.messages.role:user\",\"gen_ai.output.messages.parts.type:text\"],\"version\":1},\"environment\":\"production\",\"history\":{\"continuation_method\":\"conversation_id\",\"hash_hit\":true,\"is_new\":false,\"new_messages\":{\"end\":11,\"start\":10},\"position\":6},\"ingest\":{\"host\":\"1c7d241ffd23\",\"time\":1793180378151582},\"member\":{\"id\":\"01a181dc-9270-74f6-937b-f181d44bc174\"},\"org\":{\"id\":\"01a181dc-9258-765d-a097-503b84980b9c\"},\"project\":{\"id\":\"01a181e0-bc4b-75b7-8b40-4c37823d3185\"},\"recipe\":{\"git_commit_sha\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"run\":{\"id\":\"01a181e1-16fd-7142-8ac0-1734bfaec491\",\"root_id\":\"01a181e1-094c-7004-a41c-a8ba51c5a2c9\"},\"runtime\":{\"group_id\":\"01a181e0-cb43-723f-ae33-0f945f91df2a\",\"id\":\"01a181e0-ddde-73b3-9874-86b4d1019400\"},\"task\":{\"id\":\"01a181e1-094c-7004-a41c-a8bb2cead36e\",\"run_id\":\"01a181e1-16fd-7142-8ac0-1734bfaec491\"},\"turn\":3},\"server\":{\"addres