#!/bin/sh
# Pre-commit hook: format, warnings-as-errors build, tests with the coverage floor.
# Install with scripts/setup-hooks.sh.
set -e

echo "Checking formatting..."
scripts/lint.sh || { echo "Formatting issues. Run 'scripts/lint.sh --fix'."; exit 1; }

echo "Building (warnings are errors)..."
swift build --build-tests --enable-all-traits

echo "Running tests with coverage..."
scripts/coverage.sh

echo "All checks passed."
